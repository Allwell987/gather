EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-public-key
# Service role key for admin operations (generate-devotionals script)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxx
EXPO_PUBLIC_EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000

# OpenAI API key for AI-generated devotionals
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# YouTube Data API v3 — required for Video Library and live detection.
# See src/services/youtube.ts or Google Cloud Console Guide for setup instructions.
EXPO_PUBLIC_YOUTUBE_API_KEY=your-youtube-data-api-v3-key
# Channel ID (UCxxxxxxxxxx) — NOT the @handle. Find it in YouTube Studio → Settings → Channel.
EXPO_PUBLIC_YOUTUBE_CHANNEL_ID=your-youtube-channel-id

# Google Sign-In (Optional but recommended for identifying requester)
# Set either of these to the Google OAuth web client ID from your Google Cloud project.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-web-client-id
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id

# Sentry DSN for error tracking
EXPO_PUBLIC_SENTRY_DSN=https://xxxxxxxx.ingest.sentry.io/xxxxxxx
